    :extractedFrom "Text"^^xsd:string ;
    :hasMonitoringDescription :Peut_Devenir_Mortelle_Pour_Les_Poissons,
        "des températures supérieures à 20°C qui sont mesurées sur des périodes de deux jours consécutifs"^^xsd:string,
        "des températures supérieures à 21°C ont été enregistrées pendant 2 semaines consécutives"^^xsd:string,
        "différences de résistance thermique avec les poissons juvéniles qui semblent plus résistants que les adultes"^^xsd:string,
        "jeunes de l’année qui continuent à défendre leur territoire"^^xsd:string,
        "réponses comportementales différentes selon les classes d’âge"^^xsd:string,
        "saumons de 1 et 2 ans abandonnent leur comportement territorial"^^xsd:string,
        "taux de croissance plus faibles que ceux élevés à des températures comprises entre 13 et 16°C"^^xsd:string,
        "taux de croissance réduits après trois mois maintenus à 18°C"^^xsd:string ;
    :hasMonitoringEndDate :Aout_2017_Et_Marsavril_2018,
        :Fin_Mai_Debut_Juin_2018,
        :Juilletaout_2017 ;
    :hasMonitoringStartDate :Fevrier,
        :Fin_Mai_Debut_Juin_2018,
        :Juilletaout_2017 ;
    :hasPageNumber 27,
        28,
        29,
        30 ;
    :hasPurpose :Mesurer_Les_Temperatures_Chaudes ;
    :isImpassable :Remous_De_Breisach,
        "peut entraîner un stress physiologique chez le saumon"^^xsd:string ;
    :isLocatedIn :Fessenheim ;
    :isSubjectTo :Hydromorphologicalmonitoring ;
    skos:note "measuredAt: Fessenheim"@fr ;
    skos:prefLabel "température de l’eau à Fessenheim"@fr .

