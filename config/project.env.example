# =============================================================================
# Rhine River Restoration project configuration
# =============================================================================
#
# Copy this file before use:
#
#   cp config/project.env.example config/project.env
#
# Then edit config/project.env for your own machine or HPC environment.
#
# Do not commit config/project.env. It may contain machine-specific paths.
# =============================================================================

# Optional override for the repository root. Leave empty to use the path
# automatically inferred by the batch script.
# RHINE_PROJECT_ROOT="/absolute/path/to/repository"

# Path to the Conda shell initialization script.
# Common examples:
# CONDA_SH="${HOME}/miniforge3/etc/profile.d/conda.sh"
# CONDA_SH="${HOME}/miniconda3/etc/profile.d/conda.sh"
# CONDA_SH="/opt/conda/etc/profile.d/conda.sh"
CONDA_SH="${HOME}/miniforge3/etc/profile.d/conda.sh"

# Local directory containing downloaded Hugging Face model checkpoints.
# The default places them inside the cloned repository.
HF_MODELS_DIR="${RHINE_PROJECT_ROOT}/hf_models"

# Optional Hugging Face cache location. Leave empty to use the default cache.
# HF_HOME="/path/to/huggingface_cache"

# Set to 1 only after all required models and datasets have been downloaded.
# Leave at 0 for a first setup or when model downloads should be allowed.
TRANSFORMERS_OFFLINE=0
HF_DATASETS_OFFLINE=0

# Optional NUMA command prefix. Leave empty for portable execution.
# Example for a known NUMA topology:
# NUMA_PREFIX="numactl --cpunodebind=0 --membind=0"
NUMA_PREFIX=""

# PyTorch CUDA allocator setting. Adjust only when needed for a local system.
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Optional additional environment variables may be set below.
# Do not put tokens, passwords, API keys, or private paths in the tracked
# project.env.example file.
